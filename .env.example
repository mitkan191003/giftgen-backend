SERVICE_NAME=giftgen-api
LOG_LEVEL=INFO
METRIC_NAMESPACE=GiftGen/Application
REQUEST_ID_HEADER_NAME=X-Request-Id
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=false

DATABASE_URL=sqlite+pysqlite:///./giftgen.db
DATABASE_NAME=giftgen
DATABASE_SECRET_ID=
DATABASE_ENDPOINT=
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=development
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_ISSUER=

PUBLIC_SHARE_BASE_URL=http://localhost:3000/share

AWS_REGION=us-east-1
ASSET_STORAGE_MODE=local
ASSET_BUCKET_NAME=giftgen-assets
LOCAL_ASSET_ROOT=./var/assets

MODAL_API_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
MODAL_SECRET_ID=

OPENAI_API_KEY=
OPENAI_SECRET_ID=
