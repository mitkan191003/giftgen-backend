FROM public.ecr.aws/sam/build-python3.12:latest

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md alembic.ini ./
COPY alembic ./alembic
COPY app ./app

RUN python3 -m pip install --upgrade pip && python3 -m pip install .

CMD ["python3", "-m", "app.workers.generation", "--watch", "--interval", "10"]
